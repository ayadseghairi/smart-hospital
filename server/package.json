{
  "name": "delin-smart-care-server",
  "version": "0.1.0",
  "description": "Delin Smart Care — backend API server for Khenchela health platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:validate": "tsx prisma/validateSeed.ts",
    "create-super-admin": "tsx scripts/create-super-admin.ts",
    "reset-super-admin-password": "tsx scripts/reset-super-admin-password.ts",
    "mail:test": "tsx scripts/mail-test.ts",
    "mail:preview": "tsx scripts/mail-preview.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:check": "npm audit --omit=dev --json | node scripts/audit-check.mjs",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.5.0",
    "otpauth": "^9.6.0",
    "pg-boss": "^9.0.3",
    "pino": "^9.4.0",
    "pino-pretty": "^11.3.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.18.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "overrides": {
    "tinypool": "^2.2.0"
  }
}
