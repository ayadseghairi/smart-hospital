# ============================================================
#  Delin Smart Care — server environment variables
#  Copy this file to server/.env and fill in the values.
#  NEVER commit .env — it is in .gitignore.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://delin:delinpass@localhost:5432/delin_smart_care?schema=public"

# --- JWT secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- App ---
APP_NAME="Delin Smart Care"
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development
TZ=Africa/Algiers

# --- Mail (SMTP) ---
# Set MAIL_ENABLED=false to log emails to console instead of sending (dev only)
MAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Delin Smart Care
MAIL_FROM_ADDRESS=no-reply@delin.dz
MAIL_REPLY_TO=

# --- Tokens and timing ---
EMAIL_VERIFY_TTL_HOURS=24
INVITE_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
# Comma-separated hours before appointment to send reminders
REMINDER_OFFSETS_HOURS=24,2
# Local time (Africa/Algiers) hour for doctor daily digest (0-23)
DOCTOR_DIGEST_HOUR=7

# --- Bootstrap (first super admin) ---
# Used only by: npm run create-super-admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_FULL_NAME=

# --- Rate limiting ---
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
