# ============================================================
#  Delin Smart Care — server environment variables
#  Copy this file to server/.env and fill in the values.
#  NEVER commit .env — it is in .gitignore.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://delin:delinpass@localhost:5432/delin_smart_care?schema=public"

# --- JWT secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- App ---
APP_NAME="Delin Smart Care"
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development
TZ=Africa/Algiers

# ---------- SMTP account used to send ALL platform emails ----------
# Set MAIL_ENABLED=false to print emails to the console instead (local dev only).
# When MAIL_ENABLED=true, SMTP_HOST, SMTP_PORT, SMTP_USER and SMTP_PASS are required.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false uses STARTTLS on 587 (requireTLS enforced regardless)
SMTP_SECURE=false
# The sending email address / SMTP login username
SMTP_USER=
# The SMTP password or app password (never commit the real value)
SMTP_PASS=
MAIL_FROM_NAME=Delin Smart Care
# Optional — defaults to SMTP_USER when left empty
MAIL_FROM_ADDRESS=
# Optional support/reply address shown in Reply-To header
MAIL_REPLY_TO=

# --- Tokens and timing ---
EMAIL_VERIFY_TTL_HOURS=24
INVITE_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
# Comma-separated hours before appointment to send reminders
REMINDER_OFFSETS_HOURS=24,2
# Local time (Africa/Algiers) hour for doctor daily digest (0-23)
DOCTOR_DIGEST_HOUR=7

# ---------- First SUPER_ADMIN (bootstrap) ----------
# Used at server start (idempotent: does nothing if a SUPER_ADMIN already exists).
# Also invoked by: npm run create-super-admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_FULL_NAME=
# TEMPORARY initial password. Minimum 16 characters. Must be changed at first login.
# Remove this variable from .env immediately after the first successful login.
# If left empty, an INVITE link is sent instead (no pre-set password).
SUPER_ADMIN_INITIAL_PASSWORD=

# ---------- TOTP 2FA (required for SUPER_ADMIN) ----------
# AES-256-GCM key for encrypting stored TOTP secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Keep secret.
MFA_ENCRYPTION_KEY=

# --- Rate limiting ---
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
